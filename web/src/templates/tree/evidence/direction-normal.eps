%%BeginSetup
%%EndSetup
%%Page: 1 1
%%BeginPageSetup
%%PageBoundingBox: 0 0 788 488
%%EndPageSetup
q 0 0 788 488 rectclip
1 0 0 -1 0 488 cm q
Q q
q
0 0 788 488 re W n
[ 787.5 0 0 -487.477141 0 487.488571 ] concat
/cairo_ascii85_file currentfile /ASCII85Decode filter def
/DeviceRGB setcolorspace
<<
